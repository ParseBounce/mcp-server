  "description": "MCP server for ParseBounce — check email bounces, complaints, suppressions and deliverability stats for AWS SES, SendGrid, Mailgun, SparkPost, Postmark and Mandrill from Claude, Cursor, VS Code or any MCP client.",
  "mcpName": "com.parsebounce/parsebounce",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
